# ============ Python ============
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ============ Data — NEVER commit datasets ============
# NOTE: must be anchored with a leading slash, otherwise `data/` would also
# match src/data/ and silently exclude the pipeline code itself.
# CI regenerates the synthetic dataset from the notebook's make_scene() generator.
/data/
*.zip
*.mat

# ============ MLflow tracking state ============
# Split: metadata lives in SQLite, artifacts in mlruns/. Both local-only.
/mlruns/
/mlartifacts/
/mlflow.db
*.db

# ============ Model weights / reports ============
/models/
*.pt
*.pth
*.onnx
/outputs/
/runs/

# ============ Secrets — use GitHub Secrets instead ============
.env
*.pem

# ============ Local server logs ============
*.log

# ============ Editors / OS ============
.vscode/
.idea/
.DS_Store
Thumbs.db

# ============ Test / lint caches ============
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
